# Keep source files byte-identical across hosted runners so format checks do not
# interpret Windows checkout line endings as repository-wide style changes.
* text=auto eol=lf

# Vite's minified assets are copied byte-for-byte into the headless engine.
# Do not normalize their significant end-of-line bytes during diff checks.
crates/msc-engine/web-ui/** -whitespace

# Preserve original historical audit CSV bytes when moving the evidence directory.
docs/msc/audit/*.csv -text
